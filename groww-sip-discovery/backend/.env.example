# Copy to .env for local development. All values are optional; defaults shown.
NODE_ENV=development
PORT=5000
# Comma-separated browser origins allowed by CORS (the Vite dev server, then the Vercel URL in production).
CORS_ORIGIN=http://localhost:5173
# Server-side Groq key. Optional: the frontend can also send a key per request in the x-groq-api-key header.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=10000
# BGE embeddings for semantic rule matching on the LLM path. Run `pnpm model:download` once first.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
MAX_INPUT_CHARS=2000
LOG_LEVEL=info
